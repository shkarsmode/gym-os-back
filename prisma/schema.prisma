generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (unpooled) connection for migrations / db push — Neon's pooled URL
  // (pgbouncer) can't run the DDL, which left the ExerciseReaction table uncreated.
  // Runtime still uses the pooled `url`; directUrl is only used by Prisma CLI.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum WorkoutStatus {
  planned
  active
  completed
}

enum WorkoutSetType {
  warmup
  working
  drop
  failure
  backoff
}

model User {
  id                String                @id @default(cuid())
  email             String                @unique
  googleId          String?               @unique
  displayName       String
  avatarUrl         String?
  approved          Boolean               @default(false)
  role              String                @default("free")
  preferences       Json?
  // Workout privacy. Opt-in: a profile is public unless its owner says otherwise, so
  // shipping this must not hide anybody retroactively. privacyChoiceAt records that the
  // person has been ASKED — a null means the one-time prompt still has to be shown.
  hideWorkoutDetails Boolean              @default(false)
  privacyChoiceAt    DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  oauthAccounts     OAuthAccount[]
  profile           UserProfile?
  bodyweightEntries UserBodyweightEntry[]
  exercises         Exercise[]            @relation("CustomExercises")
  workouts          Workout[]
  personalRecords   PersonalRecord[]
  achievements      UserAchievement[]
  workoutTemplates  WorkoutTemplate[]
  exerciseReactions ExerciseReaction[]
  featureRequests   FeatureRequest[]
  feedReactions     FeedReaction[]
  feedComments      FeedComment[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  accessGrantsOwned   WorkoutAccessGrant[] @relation("AccessOwner")
  accessGrantsHeld    WorkoutAccessGrant[] @relation("AccessViewer")
  partnershipsHosted  TrainingPartnership[] @relation("PartnerHost")
  partnershipsJoined  TrainingPartnership[] @relation("PartnerGuest")
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  name                String
  displayName         String
  height              Int?
  bodyweight          Decimal? @db.Decimal(6, 2)
  // Year of birth — asked for during AI-coach onboarding. Age changes recovery and
  // strength-standard expectations, so the coach needs it; NULL when never provided.
  birthYear           Int?
  // Full date of birth as YYYY-MM-DD. `birthYear` stays and is DERIVED from this on
  // every write, so everything already reading the year — the coach's recovery and
  // strength-standard expectations — keeps working untouched whether a profile was
  // filled in before or after this shipped.
  birthDate           String?
  gender              String   @default("male")
  trainingGoal        String?
  trainingExperience  String?
  favoriteMuscleGroup String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBodyweightEntry {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  bodyweight Decimal  @db.Decimal(6, 2)
  notes      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model Exercise {
  id                    String                    @id @default(cuid())
  slug                  String                    @unique
  name                  String
  aliases               Json                      @default("[]")
  primaryMuscleGroup    String
  secondaryMuscleGroups Json                      @default("[]")
  movementPattern       String
  equipment             String
  category              String
  difficulty            String
  description           String?
  techniqueSteps        Json                      @default("[]")
  commonMistakes        Json                      @default("[]")
  safetyTips            Json                      @default("[]")
  mediaUrl              String?
  mediaType             String                    @default("none")
  sourceName            String?
  sourceUrl             String?
  originalName          String?
  licenseStatus         String?
  mediaReferences       Json                      @default("[]")
  sourceImportedAt      DateTime?
  isCustom              Boolean                   @default(false)
  // Static holds — planks, hangs, timed carries — are prescribed in seconds, not reps.
  // This is only the DEFAULT for sets added from this exercise; the measure lives per
  // set (WorkoutSet.durationSeconds), because the same movement can legitimately be
  // done either way.
  isTimed               Boolean                   @default(false)
  status                String                    @default("approved")
  createdByUserId       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  createdByUser         User?                     @relation("CustomExercises", fields: [createdByUserId], references: [id], onDelete: SetNull)
  workoutExercises      WorkoutExercise[]
  personalRecords       PersonalRecord[]
  strengthStandards     StrengthStandard[]
  templateExercises     WorkoutTemplateExercise[]
  reactions             ExerciseReaction[]

  @@index([isCustom])
  @@index([createdByUserId])
  @@index([status])
}

model ExerciseReaction {
  id         String   @id @default(cuid())
  exerciseId String
  userId     String
  type       String // "like" | "dislike"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, userId])
  @@index([exerciseId])
  @@index([userId])
}

model FeatureRequest {
  id          String   @id @default(cuid())
  userId      String
  type        String // "feature" | "fix" | "improvement"
  title       String
  description String?
  status      String   @default("new") // "new" | "planned" | "in_progress" | "done" | "declined"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Workout {
  id               String            @id @default(cuid())
  userId           String
  date             DateTime
  title            String
  status           WorkoutStatus     @default(planned)
  workoutType      String
  startedAt        DateTime?
  finishedAt       DateTime?
  // When the FIRST set of this session was ticked off, and when the LAST one was. The
  // span between them is "time actually spent in the gym" — deliberately NOT the
  // workout's duration, because a session left open overnight would report nonsense.
  firstSetAt       DateTime?
  lastSetAt        DateTime?
  durationOverride Int?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises        WorkoutExercise[]
  supersetGroups   SupersetGroup[]
  cardioSessions   CardioSession[]
  personalRecords  PersonalRecord[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, date])
}

model WorkoutExercise {
  id         String       @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int
  notes      String?
  // Membership of a superset, if any. Position inside the group (A1/A2/A3) is `order`
  // — members are contiguous, so one ordering field serves both the workout and the
  // group and the two can never disagree.
  supersetGroupId String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  workout    Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets       WorkoutSet[]
  supersetGroup SupersetGroup? @relation(fields: [supersetGroupId], references: [id], onDelete: SetNull)

  @@index([workoutId])
  @@index([exerciseId])
  @@index([supersetGroupId])
}

/// Two or three exercises performed back to back, with one rest after the whole round.
///
/// A ROUND IS THE Nth SET OF EACH MEMBER — there is deliberately no round entity. Rounds
/// already exist as sets, so weight, reps, completion, volume, personal records, history
/// and statistics all keep working through the code that already reads sets. A separate
/// round table would either duplicate that state or become a second, disagreeing answer
/// to "how many rounds are there".
///
/// The group therefore stores only what a set cannot: the rest taken after the round.
model SupersetGroup {
  id          String            @id @default(cuid())
  workoutId   String
  restSeconds Int               @default(120)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workout     Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]

  @@index([workoutId])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  type              WorkoutSetType  @default(working)
  weight            Decimal         @default(0) @db.Decimal(7, 2)
  repetitions       Int             @default(0)
  // Optional timed-set duration in seconds (planks, static holds, timed carries).
  // NULL for classic rep-based sets and every pre-existing row — never backfilled.
  durationSeconds   Int?
  rpe               Decimal?        @db.Decimal(4, 1)
  restSeconds       Int             @default(90)
  isCompleted       Boolean         @default(false)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

model CardioSession {
  id               String   @id @default(cuid())
  workoutId        String
  type             String
  durationMinutes  Int
  distance         Decimal? @db.Decimal(7, 2)
  calories         Int?
  averageHeartRate Int?
  intensity        String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  workout          Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model PersonalRecord {
  id                 String   @id @default(cuid())
  userId             String
  exerciseId         String
  workoutId          String?
  type               String
  value              Decimal  @db.Decimal(8, 2)
  estimatedOneRepMax Decimal? @db.Decimal(8, 2)
  weight             Decimal? @db.Decimal(7, 2)
  repetitions        Int?
  isEstimated        Boolean  @default(true)
  recordedAt         DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise           Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout            Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([exerciseId])
  @@index([workoutId])
}

model Achievement {
  id               String            @id @default(cuid())
  key              String            @unique
  title            String
  description      String
  category         String
  target           Int
  metric           String
  createdAt        DateTime          @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  unlockedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model StrengthStandard {
  id             String   @id @default(cuid())
  exerciseId     String
  gender         String
  bodyweightMin  Decimal  @db.Decimal(6, 2)
  bodyweightMax  Decimal  @db.Decimal(6, 2)
  level          String
  requiredWeight Decimal  @db.Decimal(7, 2)
  repetitions    Int      @default(1)
  sourceName     String
  sourceNote     String?
  isOfficial     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  exercise       Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model WorkoutTemplate {
  id          String                    @id @default(cuid())
  userId      String?
  title       String
  description String?
  type        String
  isPublic    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  user        User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  exercises   WorkoutTemplateExercise[]

  @@index([userId])
}

model WorkoutTemplateExercise {
  id                String          @id @default(cuid())
  workoutTemplateId String
  exerciseId        String
  order             Int
  targetSets        Int?
  targetReps        Int?
  restSeconds       Int?
  notes             String?
  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise          Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutTemplateId])
  @@index([exerciseId])
}

// Audit log for AI (Gemini) calls made by the admin-only AI-workout feature. One row
// per backend call. `userId` is a loose reference (no FK) so the log survives user
// deletion for auditing. Never stores prompts, transcripts, responses, or secrets —
// only safe usage metadata and normalized error codes.
model AiUsageLog {
  id                  String   @id @default(cuid())
  userId              String?
  operation           String
  model               String
  status              String
  errorCode           String?
  errorMessage        String?
  inputTokens         Int?
  outputTokens        Int?
  totalTokens         Int?
  cachedTokens        Int?
  thoughtsTokens      Int?
  durationMs          Int?
  inputLength         Int?
  recognizedExercises Int?
  warningsCount       Int?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Стрічка (social feed): reactions, threaded comments, notifications, reports
// and Web Push subscriptions. All created idempotently at boot by FeedService
// (see the FeatureRequest / ExerciseReaction precedent) so no migration step is
// needed on deploy.
//
// Reactions and comments are polymorphic (targetType + targetId) because a feed
// carries more than one kind of item — a workout, an unlocked achievement, a
// personal record — and they all take the same interactions.
// ---------------------------------------------------------------------------

model FeedReaction {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  kind       String   @default("like")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model FeedComment {
  id         String    @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  // Set for a reply; NULL for a root comment. One level deep — replies attach to
  // the root, so a thread never becomes an unbounded tree.
  parentId   String?
  body       String
  editedAt   DateTime?
  // Moderator outcome: hidden keeps the row (for the report trail) but removes it
  // from every reader's view.
  hidden     Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, createdAt])
  @@index([parentId])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  actorId    String?
  type       String
  targetType String?
  targetId   String?
  preview    String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ContentReport {
  id           String    @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       String
  details      String?
  status       String    @default("open")
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Who may see a private member's workout detail. One row per (owner, viewer).
///
/// `status` holds exactly three values and the read path compares against "accepted" and
/// nothing else. A BLOCK is a rejection carrying an absurdly distant cooldown rather than
/// a fourth status, so no future query can forget to handle it.
///
/// Rows are never deleted on cancel or unsubscribe. The row also carries the cooldown and
/// the rejection count, so deleting it would let one extra tap reset both.
model WorkoutAccessGrant {
  id            String    @id @default(cuid())
  ownerId       String
  viewerId      String
  status        String    @default("pending")
  message       String?
  rejectedCount Int       @default(0)
  cooldownUntil DateTime?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  owner         User      @relation("AccessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer        User      @relation("AccessViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, viewerId])
  @@index([viewerId, status])
  @@index([ownerId, status])
}

/// Two people training together, watching each other's sets in real time.
///
/// A PAIR by design. Shaping the table for exactly two makes "who else is in this
/// session" a question that cannot be asked, rather than one answered wrongly later.
model TrainingPartnership {
  id        String    @id @default(cuid())
  hostId    String
  guestId   String
  status    String    @default("pending")
  /// guestCanEdit opens the HOST's workout to the guest, so only the host may set it.
  /// hostCanEdit is the mirror. Never both from one call: that would let either side
  /// grant themselves access to the other's data without its owner consenting.
  guestCanEdit Boolean @default(false)
  hostCanEdit  Boolean @default(false)
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  host      User      @relation("PartnerHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest     User      @relation("PartnerGuest", fields: [guestId], references: [id], onDelete: Cascade)

  @@index([hostId, status])
  @@index([guestId, status])
}
